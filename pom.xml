<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.medicarepro</groupId>
    <artifactId>medicare-pro-swing</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>MediCare Pro - Hospital Patient Information System (parent)</name>

    <modules>
        <module>medicare-model</module>
        <module>medicare-security</module>
        <module>medicare-data</module>
        <module>medicare-service</module>
        <module>medicare-ui</module>
        <module>medicare-app</module>
    </modules>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.medicarepro</groupId>
                <artifactId>medicare-model</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.medicarepro</groupId>
                <artifactId>medicare-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.medicarepro</groupId>
                <artifactId>medicare-data</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.medicarepro</groupId>
                <artifactId>medicare-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.medicarepro</groupId>
                <artifactId>medicare-ui</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>42.7.7</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>5.11.4</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- JUnit is available to every module's tests -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.6.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
